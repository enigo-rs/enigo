{
  "name": "enigo (labwc, headless)",
  "build": {
    "context": "..",
    "dockerfile": "../Containerfile",
    "target": "labwc"
  },
  "containerEnv": {
    "WAYLAND_DISPLAY": "wayland-enigo",
    "XDG_CURRENT_DESKTOP": "labwc",
    "XDG_RUNTIME_DIR": "/tmp/enigo-labwc",
    "XDG_SESSION_TYPE": "wayland"
  },
  "init": true,
  "postStartCommand": ["sh", ".devcontainer/start-labwc.sh"],
  "remoteUser": "enigo",
  "updateRemoteUserUID": true,
  "customizations": {
    "zed": {
      "extensions": [
        "toml",
        "dockerfile"
      ]
    }
  }
}
