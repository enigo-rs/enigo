{
  "name": "enigo (GNOME X11)",
  "build": {
    "context": "..",
    "dockerfile": "../Containerfile",
    "target": "gnome-x11"
  },
  "containerEnv": {
    "DBUS_SESSION_BUS_ADDRESS": "unix:path=/tmp/enigo-gnome-bus",
    "DISPLAY": ":99",
    "ENIGO_RESTORE_TOKEN_FILE": "/tmp/enigo-gnome/restore-token",
    "GDK_BACKEND": "x11",
    "GTK_A11Y": "none",
    "NO_AT_BRIDGE": "1",
    "WAYLAND_DISPLAY": "",
    "XAUTHORITY": "",
    "XDG_CONFIG_HOME": "/tmp/enigo-gnome-config",
    "XDG_CURRENT_DESKTOP": "GNOME",
    "XDG_DATA_HOME": "/tmp/enigo-gnome-data",
    "XDG_DESKTOP_PORTAL_TEST_APP_ID": "enigo-test",
    "XDG_DESKTOP_PORTAL_TEST_APP_INFO_KIND": "host",
    "XDG_DESKTOP_PORTAL_TEST_HOST_APPID": "enigo-test",
    "XDG_RUNTIME_DIR": "/tmp/enigo-gnome",
    "XDG_SESSION_TYPE": "x11"
  },
  "postStartCommand": ["sh", ".devcontainer/gnome-x11/start-x11.sh"],
  "remoteUser": "enigo",
  "updateRemoteUserUID": true,
  "customizations": {
    "zed": {
      "extensions": [
        "toml",
        "dockerfile"
      ]
    }
  }
}
